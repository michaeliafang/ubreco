#include "matchTools.fcl"
#include "priorityTools.fcl"

BEGIN_PROLOG
# Experimental settings: require validation on signal and neutrino/EXT samples.
# This table is inert until assigned to showerreco3d.SingleShowerRecovery.
single_shower_recovery: {
  Enable: true
  SaveSplitCandidates: true
  DiagnoseTwoShowers: true    # diagnostic fallback for ineligible two-shower events
  DiagnoseThreeShowers: true  # also save diagnostic splits of the original inputs
  RecoverTwoShowers: true     # independent experimental option
  MinSelectedHitCoverage: 0.98 # unique output hits / selected hits in retained planes
  CoverageHitProducer: "nugraphshowerhits"
  UseCmergerRecoverySeeds: true # preserve existing clusters; attach/split/match alternatives
  CombineTwoShowerHits: true  # combine both baseline showers per plane before splitting
  RecoverThreeShowers: true   # attach a distant small fragment to either main shower
  ThreeShowerMaxFragmentChargeFraction: 0.20 # strict less-than, total collection charge
  MaxFragmentAttachmentAngle: 35.0 # degrees to parent direction, forward attachments only
  SearchSubstantialClusterPairs: true # independent of original matcher group count
  MaxPairClustersPerPlane: 3  # at most 36 two-plane assignments per split trial
  MinPairPlaneChargeCoverage: 0.80 # selected clusters retain this fraction in EACH view
  DetachedShowerMinDistance: 20.0 # cm in 3D; strict greater-than
  DetachedShowerMaxChargeFraction: 0.30 # positive collection-plane charge; strict less-than
  RecoveredPairMaxStartDistance: 5.0 # both replacement starts within this 3D radius
  AllowTwoPlaneFallback: true # collection + induction, after full-view options in each trial
  MinTwoPlaneShowerWeight: 3.0 # consistent mapped-spacepoint weight for EACH shower
  TryAlternativePairings: true # only with sufficient mapped spacepoint evidence
  MatchTool: @local::match_cfalgoiou
  PriorityTool: @local::priority_cpalgonhits
  MinHits: 10
  MinUpstreamHits: 6
  MaxHits: 6000
  NeighborRadius: 0.8          # cm; Euclidean scoring graph, not proximity RMS overlap
  InnerRadius: 0.0             # include near-vertex hits in trajectory evidence
  UpstreamRadius: 10.0         # cm
  MaxStartRadius: 5.0         # cm; at least MinStartHits on each sustained start
  MinStartHits: 3
  MinTrackSpan: 3.0           # cm along each early trajectory
  MaxTrackGap: 3.0            # cm; maximum gap along a supported run
  TrackWidth: 0.6             # cm; perpendicular distance from fitted ray
  MinTrackFraction: 0.0       # disabled; retain minimum support count and span
  MaxEdges: 200000            # reject excessively dense candidates
  MaxMatchTrials: 4           # maximum cross-plane matching retries per event
  MaxRecoShowers: 4           # total additional proto-showers reconstructed per event
  AngleStepDegrees: 2.0
  MinOpeningDegrees: 5.0      # between upstream mean directions, not the merger's 15 deg
  MinChargeFraction: 0.20      # each daughter must carry >=20% of parent cluster charge
  MaxCutFraction: 0.15
  MaxCandidatesPerPlane: 2     # up to 26 candidates, bounded by MaxMatchTrials
  MinOriginalHitFraction: 0.8
}
END_PROLOG
